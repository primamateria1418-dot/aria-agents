# ── ARIA SECURITY ──────────────────────────────────────────
ARIA_API_KEY=your-secret-key-here
ARIA_ACCOUNT_TYPE=aria_internal

# ── SUPABASE ───────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-anon-key-here

# ── TELEGRAM ───────────────────────────────────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_NOTIFY_CHAT_ID=

# ── LLM ────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama3-70b-8192

# ── SEARCH ─────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...
SEARXNG_URL=http://localhost:8080

# ── JAMIE CONFIG ───────────────────────────────────────────
JAMIE_SCORE_THRESHOLD=7
JAMIE_HOT_THRESHOLD=8
JAMIE_MESSAGES_PER_GROUP=50
JAMIE_TARGET_GROUPS=@group1,@group2

# ── CLIENT ─────────────────────────────────────────────────
CLIENT_ID=aria_internal

# ── LOCAL DEV (optional) ────────────────────────────────────
LM_STUDIO_URL=http://localhost:1234/v1/chat/completions
LM_STUDIO_MODEL=local-model
